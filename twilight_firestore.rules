rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /projects/{p} {
      allow read: if request.auth != null && (resource.data.published == true || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && resource.data.published != true
        && (request.resource.data.published == resource.data.published || request.auth.uid == resource.data.owner)
        && (request.auth.uid in resource.data.members
        || exists(/databases/$(database)/documents/invites/$(p + '_' + request.auth.uid)));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
      match /media/{f} {
        allow read: if request.auth != null && (get(/databases/$(database)/documents/projects/$(p)).data.published == true
          || request.auth.uid in get(/databases/$(database)/documents/projects/$(p)).data.members);
        allow create, update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/projects/$(p)).data.members
          && get(/databases/$(database)/documents/projects/$(p)).data.published != true;
        allow delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/projects/$(p)).data.owner;
      }
      match /frames/{f} {
        allow read: if request.auth != null && (get(/databases/$(database)/documents/projects/$(p)).data.published == true
          || request.auth.uid in get(/databases/$(database)/documents/projects/$(p)).data.members);
        allow create, update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/projects/$(p)).data.members
          && get(/databases/$(database)/documents/projects/$(p)).data.published != true;
        allow delete: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/projects/$(p)).data.owner
          || request.auth.uid in get(/databases/$(database)/documents/projects/$(p)).data.members && get(/databases/$(database)/documents/projects/$(p)).data.published != true);
      }
    }
    // Star ratings on published projects: one doc per user (doc id = user's uid), stars 1-5.
    match /projects/{p}/ratings/{u} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/projects/$(p)).data.published == true;
      allow create, update: if request.auth != null && request.auth.uid == u
        && get(/databases/$(database)/documents/projects/$(p)).data.published == true
        && request.resource.data.keys().hasOnly(['stars', 'name', 'ts'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if request.auth != null && request.auth.uid == u;
    }
    match /invites/{i} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
  }
}
